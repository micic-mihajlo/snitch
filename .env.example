# Required for the fast semantic ticker and warning/repair loop.
CEREBRAS_API_KEY=
# Optional: set to a public model id or your org's dedicated endpoint id.
CEREBRAS_MODEL=gpt-oss-120b
# Optional: provider timeout for `snitch insights` and live `watch --insights`.
SNITCH_PROVIDER_TIMEOUT_MS=12000

# Optional: route memory / repo conventions / handoff through Backboard.
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

# Optional: import/export 8090 Software Factory work orders.
SOFTWARE_FACTORY_API_KEY=
SOFTWARE_FACTORY_MCP_URL=
SOFTWARE_FACTORY_PROJECT_ID=
